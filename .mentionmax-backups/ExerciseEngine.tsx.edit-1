import { useState } from "react";

export type ExerciseQuestion = {
  id: number;
  subject: string;
  chapter: string;
  title: string;
  difficulty: "Easy" | "Medium" | "Hard";
  duration: number;
  statement: string;
  acceptedAnswers: string[];
  explanation: string;
  hint: string;
};

type Props = {
  exercise: ExerciseQuestion;
  onComplete: () => void;
  onBack: () => void;
};

function normalize(value: string) {
  return value
    .toLowerCase()
    .replace(/\s+/g, "")
    .replace(",", ".");
}

export default function ExerciseEngine({
  exercise,
  onComplete,
  onBack,
}: Props) {
  const [answer, setAnswer] = useState("");
  const [submitted, setSubmitted] = useState(false);
  const [correct, setCorrect] = useState(false);
  const [showHint, setShowHint] = useState(false);

  function submit() {
    const normalized = normalize(answer);

    const isCorrect = exercise.acceptedAnswers.some(
      (accepted) => normalize(accepted) === normalized,
    );

    setCorrect(isCorrect);
    setSubmitted(true);

    if (isCorrect) {
      onComplete();
    }
  }

  return (
    <div className="engine">
      <button className="back-button" onClick={onBack}>
        ← Back to exercises
      </button>

      <div className="engine-meta">
        <span>{exercise.subject}</span>
        <span>·</span>
        <span>{exercise.chapter}</span>
      </div>

      <h1>{exercise.title}</h1>

      <section className="statement">
        <span className="eyebrow">QUESTION</span>
        <p>{exercise.statement}</p>
      </section>

      <section className="answer-section">
        <label htmlFor="answer">Your answer</label>

        <input
          id="answer"
          value={answer}
          onChange={(event) => setAnswer(event.target.value)}
          placeholder="Enter your answer..."
          disabled={submitted && correct}
          onKeyDown={(event) => {
            if (event.key === "Enter") submit();
          }}
        />

        <div className="engine-actions">
          <button
            className="button secondary"
            onClick={() => setShowHint(true)}
          >
            Show hint
          </button>

          <button
            className="button primary"
            onClick={submit}
            disabled={!answer.trim() || (submitted && correct)}
          >
            Check answer
          </button>
        </div>
      </section>

      {showHint && (
        <section className="hint-box">
          <strong>Hint</strong>
          <p>{exercise.hint}</p>
        </section>
      )}

      {submitted && (
        <section className={correct ? "result correct" : "result incorrect"}>
          <div className="result-icon">{correct ? "✓" : "!"}</div>

          <div>
            <strong>{correct ? "Correct." : "Not quite."}</strong>

            {!correct && (
              <p>
                Check your calculation and try again before looking at the
                explanation.
              </p>
            )}

            {correct && (
              <>
                <p>{exercise.explanation}</p>

                <button className="button primary" onClick={onBack}>
                  Continue →
                </button>
              </>
            )}
          </div>
        </section>
      )}
    </div>
  );
}
