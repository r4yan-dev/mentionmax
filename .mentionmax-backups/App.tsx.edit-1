import { useEffect, useMemo, useState } from "react";
import ExerciseEngine from "./features/exercises/ExerciseEngine";
import { exerciseBank } from "./features/exercises/exercises";
import type { ExerciseQuestion } from "./features/exercises/ExerciseEngine";
import "./index.css";

type Page =
  | "dashboard"
  | "subjects"
  | "exercises"
  | "exercise"
  | "ai"
  | "progress"
  | "settings";

type Subject = {
  id: string;
  name: string;
  short: string;
  color: string;
  soft: string;
};

type Exercise = ExerciseQuestion;


const subjects: Subject[] = [
  { id: "math", name: "Mathematics", short: "MATH", color: "teal", soft: "seafoam" },
  { id: "physics", name: "Physics-Chemistry", short: "PC", color: "burgundy", soft: "rose" },
  { id: "svt", name: "SVT", short: "SVT", color: "olive", soft: "olive-soft" },
  { id: "french", name: "Français", short: "FR", color: "magenta", soft: "pink" },
  { id: "english", name: "English", short: "EN", color: "ocean", soft: "blue-soft" },
];

const exercises: Exercise[] = exerciseBank;

const storageKeys = {
  completed: "mentionmax.completed",
  theme: "mentionmax.theme",
  goal: "mentionmax.goal",
  notifications: "mentionmax.notifications",
};

function readNumberArray(key: string): number[] {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : [];
  } catch {
    return [];
  }
}

function App() {
  const [page, setPage] = useState<Page>("dashboard");
  const [selectedExercise, setSelectedExercise] = useState<Exercise | null>(null);
  const [completed, setCompleted] = useState<number[]>(
    () => readNumberArray(storageKeys.completed),
  );
  const [dark, setDark] = useState(
    () => localStorage.getItem(storageKeys.theme) === "dark",
  );
  const [goal, setGoal] = useState(
    () => Number(localStorage.getItem(storageKeys.goal)) || 90,
  );
  const [notifications, setNotifications] = useState(
    () => localStorage.getItem(storageKeys.notifications) !== "off",
  );
  const [sidebarOpen, setSidebarOpen] = useState(false);

  useEffect(() => {
    localStorage.setItem(storageKeys.completed, JSON.stringify(completed));
  }, [completed]);

  useEffect(() => {
    localStorage.setItem(storageKeys.theme, dark ? "dark" : "light");
  }, [dark]);

  useEffect(() => {
    localStorage.setItem(storageKeys.goal, String(goal));
  }, [goal]);

  useEffect(() => {
    localStorage.setItem(
      storageKeys.notifications,
      notifications ? "on" : "off",
    );
  }, [notifications]);

  const solved = completed.length;
  const total = exercises.length;
  const overallProgress = Math.round((solved / total) * 100);

  const subjectProgress = subjects.map((subject) => {
    const subjectExercises = exercises.filter(
      (exercise) => exercise.subject === subject.name,
    );
    const subjectSolved = subjectExercises.filter((exercise) =>
      completed.includes(exercise.id),
    ).length;

    return {
      ...subject,
      progress: subjectExercises.length
        ? Math.round((subjectSolved / subjectExercises.length) * 100)
        : 0,
      total: subjectExercises.length,
    };
  });

  function navigate(next: Page) {
    setPage(next);
    setSidebarOpen(false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function openExercise(exercise: Exercise) {
    setSelectedExercise(exercise);
    navigate("exercise");
  }

  function completeExercise(id: number) {
    setCompleted((current) =>
      current.includes(id) ? current : [...current, id],
    );
  }

  function toggleTheme() {
    setDark((current) => !current);
  }

  return (
    <div className={dark ? "app dark" : "app"}>
      <aside className={sidebarOpen ? "sidebar open" : "sidebar"}>
        <div className="brand">
          <div className="brand-mark">M</div>
          <div>
            <strong>MentionMax</strong>
            <span>Bac preparation</span>
          </div>
        </div>

        <nav>
          <div className="nav-label">WORKSPACE</div>

          <NavButton
            active={page === "dashboard"}
            icon="⌂"
            label="Overview"
            onClick={() => navigate("dashboard")}
          />
          <NavButton
            active={page === "subjects"}
            icon="▦"
            label="Subjects"
            onClick={() => navigate("subjects")}
          />
          <NavButton
            active={page === "exercises" || page === "exercise"}
            icon="✓"
            label="Exercises"
            onClick={() => navigate("exercises")}
          />
          <NavButton
            active={page === "ai"}
            icon="✦"
            label="AI Assistant"
            onClick={() => navigate("ai")}
          />
          <NavButton
            active={page === "progress"}
            icon="↗"
            label="Progress"
            onClick={() => navigate("progress")}
          />

          <div className="nav-label spaced">ACCOUNT</div>

          <NavButton
            active={page === "settings"}
            icon="⚙"
            label="Settings"
            onClick={() => navigate("settings")}
          />
        </nav>

        <div className="profile">
          <div className="avatar">R</div>
          <div>
            <strong>Student</strong>
            <span>1BAC Science Maths</span>
          </div>
        </div>
      </aside>

      {sidebarOpen && (
        <button
          className="overlay"
          aria-label="Close menu"
          onClick={() => setSidebarOpen(false)}
        />
      )}

      <main className="main">
        <header className="topbar">
          <button
            className="mobile-menu"
            aria-label="Open navigation"
            onClick={() => setSidebarOpen(true)}
          >
            ☰
          </button>

          <div className="crumb">
            <span>MentionMax</span>
            <b>/</b>
            <strong>{page === "exercise" ? "Exercise" : page}</strong>
          </div>

          <button
            className="theme-button"
            title="Toggle light/dark mode"
            onClick={toggleTheme}
          >
            {dark ? "☀" : "◐"}
          </button>
        </header>

        <div className="content">
          {page === "dashboard" && (
            <Dashboard
              progress={overallProgress}
              solved={solved}
              subjectProgress={subjectProgress}
              completed={completed}
              onNavigate={navigate}
              onExercise={openExercise}
            />
          )}

          {page === "subjects" && (
            <Subjects
              subjectProgress={subjectProgress}
              onExercise={openExercise}
            />
          )}

          {page === "exercises" && (
            <Exercises
              completed={completed}
              onExercise={openExercise}
            />
          )}

          {page === "exercise" && selectedExercise && (
            <ExerciseEngine
              exercise={
                exerciseBank.find((item) => item.id === selectedExercise.id) ??
                exerciseBank[0]
              }
              onComplete={() => completeExercise(selectedExercise.id)}
              onBack={() => navigate("exercises")}
            />
          )}

          {page === "ai" && (
            <Assistant completed={completed} onExercise={openExercise} />
          )}

          {page === "progress" && (
            <Progress
              progress={overallProgress}
              solved={solved}
              subjectProgress={subjectProgress}
            />
          )}

          {page === "settings" && (
            <Settings
              dark={dark}
              setDark={setDark}
              goal={goal}
              setGoal={setGoal}
              notifications={notifications}
              setNotifications={setNotifications}
              solved={solved}
            />
          )}
        </div>
      </main>
    </div>
  );
}

function NavButton({
  active,
  icon,
  label,
  onClick,
}: {
  active: boolean;
  icon: string;
  label: string;
  onClick: () => void;
}) {
  return (
    <button className={active ? "nav-button active" : "nav-button"} onClick={onClick}>
      <span>{icon}</span>
      {label}
    </button>
  );
}

function Dashboard({
  progress,
  solved,
  subjectProgress,
  completed,
  onNavigate,
  onExercise,
}: {
  progress: number;
  solved: number;
  subjectProgress: (Subject & { progress: number; total: number })[];
  completed: number[];
  onNavigate: (page: Page) => void;
  onExercise: (exercise: Exercise) => void;
}) {
  const nextExercise =
    exercises.find((exercise) => !completed.includes(exercise.id)) ?? exercises[0];

  return (
    <>
      <section className="hero">
        <div className="hero-copy">
          <span className="eyebrow">YOUR STUDY SPACE</span>
          <h1>
            Keep moving,
            <br />
            <em>one exercise at a time.</em>
          </h1>
          <p>
            MentionMax keeps your Bac preparation focused around practice,
            progress, and useful feedback.
          </p>

          <div className="actions">
            <button
              className="button primary"
              onClick={() => onExercise(nextExercise)}
            >
              {completed.includes(nextExercise.id)
                ? "Review next exercise"
                : "Continue studying"}{" "}
              →
            </button>

            <button
              className="button light"
              onClick={() => onNavigate("ai")}
            >
              Ask MentionMax AI
            </button>
          </div>
        </div>

        <div className="hero-visual" aria-hidden="true">
          <div className="hero-h">M</div>
          <div className="ring ring1" />
          <div className="ring ring2" />
          <div className="book book1" />
          <div className="book book2" />
          <div className="person">
            <div className="head" />
            <div className="hair" />
            <div className="body" />
            <div className="arm" />
          </div>
        </div>
      </section>

      <div className="stats">
        <Stat label="Exercises solved" value={`${solved}`} detail={`of ${exercises.length}`} />
        <Stat label="Overall progress" value={`${progress}%`} detail="current" />
        <Stat label="Study goal" value="90 min" detail="daily target" />
        <Stat label="Subjects" value={`${subjects.length}`} detail="active" />
      </div>

      <SectionTitle
        eyebrow="SUBJECTS"
        title="Your current preparation"
        action="View all subjects →"
        onClick={() => onNavigate("subjects")}
      />

      <div className="subject-grid">
        {subjectProgress.slice(0, 4).map((subject) => (
          <button
            className={`subject-card ${subject.soft}`}
            key={subject.id}
            onClick={() => onNavigate("exercises")}
          >
            <div className="subject-top">
              <span className={`subject-icon ${subject.color}`}>
                {subject.short.slice(0, 1)}
              </span>
              <small>{subject.short}</small>
            </div>

            <h3>{subject.name}</h3>

            <div className="progress-row">
              <span>{subject.progress}% complete</span>
              <span>{subject.total} exercises</span>
            </div>

            <ProgressBar value={subject.progress} color={subject.color} />
          </button>
        ))}
      </div>

      <div className="two-column">
        <section className="panel">
          <SectionTitle
            eyebrow="PRACTICE"
            title="Recommended next"
            action="Full library →"
            onClick={() => onNavigate("exercises")}
          />

          <div className="exercise-list">
            {exercises.slice(0, 3).map((exercise) => (
              <ExerciseRow
                key={exercise.id}
                exercise={exercise}
                completed={completed.includes(exercise.id)}
                onClick={() => onExercise(exercise)}
              />
            ))}
          </div>
        </section>

        <section className="panel ai-panel">
          <span className="ai-symbol">✦</span>
          <span className="eyebrow light-eyebrow">MENTIONMAX AI</span>
          <h3>Study with context, not generic answers.</h3>
          <p>
            Ask for an explanation, a hint, or a correction and keep the
            conversation tied to your preparation.
          </p>
          <button className="button white" onClick={() => onNavigate("ai")}>
            Open assistant →
          </button>
        </section>
      </div>
    </>
  );
}

function Stat({
  label,
  value,
  detail,
}: {
  label: string;
  value: string;
  detail: string;
}) {
  return (
    <div className="stat">
      <span>{label}</span>
      <strong>{value}</strong>
      <small>{detail}</small>
    </div>
  );
}

function SectionTitle({
  eyebrow,
  title,
  action,
  onClick,
}: {
  eyebrow: string;
  title: string;
  action?: string;
  onClick?: () => void;
}) {
  return (
    <div className="section-title">
      <div>
        <span className="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
      </div>

      {action && onClick && (
        <button className="text-button" onClick={onClick}>
          {action}
        </button>
      )}
    </div>
  );
}

function ProgressBar({
  value,
  color,
}: {
  value: number;
  color: string;
}) {
  return (
    <div className="progress-track">
      <div
        className={`progress-fill ${color}`}
        style={{ width: `${value}%` }}
      />
    </div>
  );
}

function SubjectCardVisual({
  subject,
  onExercise,
}: {
  subject: Subject & { progress: number; total: number };
  onExercise: (exercise: Exercise) => void;
}) {
  const exercise = exercises.find((item) => item.subject === subject.name);

  return (
    <article className={`large-subject ${subject.soft}`}>
      <div className="subject-top">
        <span className={`subject-icon large ${subject.color}`}>
          {subject.short.slice(0, 1)}
        </span>
        <small>{subject.short}</small>
      </div>

      <h3>{subject.name}</h3>
      <p>
        Practice exercises and track how much of your current material you have
        completed.
      </p>

      <div className="large-progress">
        <div className="progress-row">
          <span>Progress</span>
          <strong>{subject.progress}%</strong>
        </div>
        <ProgressBar value={subject.progress} color={subject.color} />
      </div>

      {exercise && (
        <button className="button small" onClick={() => onExercise(exercise)}>
          Practice →
        </button>
      )}
    </article>
  );
}

function Subjects({
  subjectProgress,
  onExercise,
}: {
  subjectProgress: (Subject & { progress: number; total: number })[];
  onExercise: (exercise: Exercise) => void;
}) {
  return (
    <>
      <PageHeader
        eyebrow="CURRICULUM"
        title="Subjects"
        description="Your study areas, each connected directly to practice."
      />

      <div className="large-subject-grid">
        {subjectProgress.map((subject) => (
          <SubjectCardVisual
            key={subject.id}
            subject={subject}
            onExercise={onExercise}
          />
        ))}
      </div>
    </>
  );
}

function Exercises({
  completed,
  onExercise,
}: {
  completed: number[];
  onExercise: (exercise: Exercise) => void;
}) {
  const [filter, setFilter] = useState("All");

  const filtered = useMemo(
    () =>
      exercises.filter(
        (exercise) => filter === "All" || exercise.subject === filter,
      ),
    [filter],
  );

  return (
    <>
      <PageHeader
        eyebrow="PRACTICE"
        title="Exercise library"
        description="Pick an exercise, solve it, then mark it complete. Your progress updates immediately."
      />

      <div className="filters">
        {["All", ...subjects.map((subject) => subject.name)].map((item) => (
          <button
            key={item}
            className={filter === item ? "filter active" : "filter"}
            onClick={() => setFilter(item)}
          >
            {item}
          </button>
        ))}
      </div>

      <section className="panel exercise-panel">
        {filtered.map((exercise) => (
          <ExerciseRow
            key={exercise.id}
            exercise={exercise}
            completed={completed.includes(exercise.id)}
            onClick={() => onExercise(exercise)}
          />
        ))}
      </section>
    </>
  );
}

function ExerciseRow({
  exercise,
  completed,
  onClick,
}: {
  exercise: Exercise;
  completed: boolean;
  onClick: () => void;
}) {
  return (
    <button className="exercise-row" onClick={onClick}>
      <span className="exercise-number">
        {String(exercise.id).padStart(2, "0")}
      </span>

      <span className={`dot ${subjectColor(exercise.subject)}`} />

      <span className="exercise-main">
        <small>{exercise.subject}</small>
        <strong>{exercise.title}</strong>
      </span>

      <span className="difficulty">{exercise.difficulty}</span>
      <span className="duration">{exercise.duration} min</span>

      <span className={completed ? "completed-mark" : "arrow"}>
        {completed ? "✓" : "→"}
      </span>
    </button>
  );
}

function Assistant({
  completed,
  onExercise,
}: {
  completed: number[];
  onExercise: (exercise: Exercise) => void;
}) {
  const [input, setInput] = useState("");
  const [messages, setMessages] = useState<
    { role: "ai" | "user"; text: string }[]
  >([
    {
      role: "ai",
      text:
        "I'm MentionMax AI. Ask about a concept, a study strategy, or an exercise. This MVP uses local responses; the production AI layer comes later.",
    },
  ]);

  function send(text = input) {
    const value = text.trim();
    if (!value) return;

    const lower = value.toLowerCase();
    let response =
      "For the MVP, I can help you navigate the preparation, suggest an exercise, or explain how the study workflow works.";

    if (lower.includes("exercise")) {
      const next =
        exercises.find((exercise) => !completed.includes(exercise.id)) ??
        exercises[0];

      response = `Your next unfinished exercise is "${next.title}" in ${next.subject}. Open it and work through the problem before asking for a hint.`;
    } else if (
      lower.includes("math") ||
      lower.includes("mathematics")
    ) {
      response =
        "For Mathematics, prioritize exercises over passive review. Start with functions and variation, then move toward harder problems.";
    } else if (lower.includes("physics")) {
      response =
        "For Physics-Chemistry, write the physical law first, define your variables and units, then substitute values. That workflow catches a surprising number of mistakes.";
    } else if (lower.includes("progress")) {
      response = `You've completed ${completed.length} of ${exercises.length} MVP exercises. Your current exercise completion is ${Math.round(
        (completed.length / exercises.length) * 100,
      )}%.`;
    } else if (lower.includes("hello") || lower.includes("hi")) {
      response =
        "Hello. Human civilization has produced another study session. Let's make it useful.";
    }

    setMessages((current) => [
      ...current,
      { role: "user", text: value },
      { role: "ai", text: response },
    ]);
    setInput("");
  }

  return (
    <>
      <PageHeader
        eyebrow="INTELLIGENCE"
        title="MentionMax AI"
        description="An assistant attached to your learning workflow."
      />

      <div className="assistant-layout">
        <section className="chat">
          <div className="chat-header">
            <div className="assistant-icon">✦</div>
            <div>
              <strong>MentionMax AI</strong>
              <span>Study assistant</span>
            </div>
          </div>

          <div className="messages">
            {messages.map((message, index) => (
              <div
                key={index}
                className={`message ${
                  message.role === "user" ? "user-message" : ""
                }`}
              >
                {message.role === "ai" && <span>✦</span>}
                <p>{message.text}</p>
              </div>
            ))}
          </div>

          <div className="chat-input">
            <textarea
              value={input}
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={(event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                  event.preventDefault();
                  send();
                }
              }}
              placeholder="Ask something..."
            />
            <button className="send" onClick={() => send()}>
              ↑
            </button>
          </div>
        </section>

        <aside className="quick-actions">
          <span className="eyebrow">QUICK ACTIONS</span>

          <button onClick={() => send("Give me an exercise")}>
            Recommend an exercise
          </button>

          <button onClick={() => send("Explain mathematics")}>
            Explain Mathematics
          </button>

          <button onClick={() => send("Explain physics")}>
            Help with Physics
          </button>

          <button onClick={() => send("Show my progress")}>
            Analyze my progress
          </button>

          <div className="ai-callout">
            <strong>Current MVP</strong>
            <p>
              The interface and workflow are real. The model connection is the
              next backend layer, not a fake loading spinner pretending to be
              intelligence.
            </p>
          </div>

          <button
            className="quick-primary"
            onClick={() =>
              onExercise(
                exercises.find((exercise) => !completed.includes(exercise.id)) ??
                  exercises[0],
              )
            }
          >
            Practice now →
          </button>
        </aside>
      </div>
    </>
  );
}

function Progress({
  progress,
  solved,
  subjectProgress,
}: {
  progress: number;
  solved: number;
  subjectProgress: (Subject & { progress: number; total: number })[];
}) {
  return (
    <>
      <PageHeader
        eyebrow="PERFORMANCE"
        title="Progress"
        description="A simple view of what is finished and where your preparation currently stands."
      />

      <div className="progress-summary">
        <div className="big-score">
          <span>Exercise completion</span>
          <strong>{progress}%</strong>
          <small>
            {solved} of {exercises.length} exercises
          </small>
        </div>

        <div className="subject-progress-list">
          {subjectProgress.map((subject) => (
            <div key={subject.id}>
              <div className="progress-row">
                <span>{subject.name}</span>
                <strong>{subject.progress}%</strong>
              </div>
              <ProgressBar value={subject.progress} color={subject.color} />
            </div>
          ))}
        </div>
      </div>

      <div className="panel">
        <SectionTitle eyebrow="READING YOUR DATA" title="What to do next" />
        <div className="recommendation">
          <span>01</span>
          <div>
            <strong>Finish unfinished exercises before adding more scope.</strong>
            <p>
              An MVP should make the next useful action obvious. Completing
              your current exercise set is more valuable than adding another
              dashboard widget.
            </p>
          </div>
        </div>
      </div>
    </>
  );
}

function Settings({
  dark,
  setDark,
  goal,
  setGoal,
  notifications,
  setNotifications,
  solved,
}: {
  dark: boolean;
  setDark: (value: boolean) => void;
  goal: number;
  setGoal: (value: number) => void;
  notifications: boolean;
  setNotifications: (value: boolean) => void;
  solved: number;
}) {
  return (
    <>
      <PageHeader
        eyebrow="ACCOUNT"
        title="Settings"
        description="These preferences are persisted locally in this MVP."
      />

      <section className="settings">
        <SettingRow
          title="Appearance"
          description="Switch between the MentionMax light and dark environments."
        >
          <button className="toggle" onClick={() => setDark(!dark)}>
            <span className={dark ? "knob on" : "knob"} />
            {dark ? "Dark" : "Light"}
          </button>
        </SettingRow>

        <SettingRow
          title="Daily study goal"
          description={`Current target: ${goal} minutes`}
        >
          <input
            className="range"
            type="range"
            min="30"
            max="240"
            step="15"
            value={goal}
            onChange={(event) => setGoal(Number(event.target.value))}
          />
        </SettingRow>

        <SettingRow
          title="Notifications"
          description="Study reminders and progress notifications."
        >
          <button
            className={notifications ? "status on" : "status"}
            onClick={() => setNotifications(!notifications)}
          >
            {notifications ? "Enabled" : "Disabled"}
          </button>
        </SettingRow>

        <SettingRow
          title="Local progress"
          description="Your current MVP completion state."
        >
          <strong>{solved} exercises completed</strong>
        </SettingRow>
      </section>
    </>
  );
}

function SettingRow({
  title,
  description,
  children,
}: {
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <div className="setting-row">
      <div>
        <strong>{title}</strong>
        <p>{description}</p>
      </div>
      <div>{children}</div>
    </div>
  );
}

function PageHeader({
  eyebrow,
  title,
  description,
}: {
  eyebrow: string;
  title: string;
  description: string;
}) {
  return (
    <header className="page-header">
      <span className="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
  );
}

function subjectColor(subject: string) {
  if (subject === "Mathematics") return "teal";
  if (subject === "Physics-Chemistry") return "burgundy";
  if (subject === "SVT") return "olive";
  if (subject === "Français") return "magenta";
  return "ocean";
}

export default App;
